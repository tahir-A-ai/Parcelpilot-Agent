# --- Application ---
APP_NAME="ParcelPilot"
APP_ENV="development"
LOG_LEVEL="INFO"

# --- Database (SQLite via aiosqlite) ---
# Relative path is resolved from Backend/ working directory at startup.
DATABASE_URL="sqlite+aiosqlite:///./data/parcelpilot.db"

# --- ChromaDB ---
CHROMA_PERSIST_DIR="./data/chroma_db"
CHROMA_COLLECTION_NAME="parcelpilot_docs"

# --- Business Logic Constants (from PROJECT_SPEC.md) ---
# ISO-8601 reference snapshot time for SLA calculations.
REFERENCE_DATETIME="2026-08-16T11:00:00+05:30"
# Credits above this threshold require manager escalation.
HIGH_VALUE_CREDIT_THRESHOLD_INR=1000.0

# --- LLM / Agent (add your provider key here) ---
# OPENAI_API_KEY="sk-..."
# ANTHROPIC_API_KEY="..."
